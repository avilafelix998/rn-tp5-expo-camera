{
  "expo": {
    "name": "LoginFacial",
    "slug": "login-facial",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que $(PRODUCT_NAME) acceda a tu cámara para reconocimiento facial.",
          "microphonePermission": "Permite que $(PRODUCT_NAME) acceda al micrófono.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}